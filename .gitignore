node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---------------------------------------------------------
# 10. Infrastructure (Bicep, Azure CLI)
# ---------------------------------------------------------
infra/**/*.parameters.local.json
infra/**/*.local.bicepparam
.azure/

# ---------------------------------------------------------
