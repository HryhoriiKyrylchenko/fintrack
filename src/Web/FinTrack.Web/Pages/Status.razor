@page "/"
@implements IDisposable
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Status.PageTitle"]</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">@L["Status.Title"]</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">@L["Status.Description"]</MudText>

@if (checking)
{
    <MudCard Elevation="0" Outlined="true" aria-busy="true" aria-label="@L["Status.Checking"]">
        <MudCardContent>
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Height="32px" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="35%" />
        </MudCardContent>
    </MudCard>
}
else if (health is { } report)
{
    <MudCard Elevation="0" Outlined="true">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" aria-hidden="true" />
                <MudText Typo="Typo.h6" HtmlTag="p">@L["Status.Healthy"]</MudText>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" HtmlTag="p" Class="mt-2">
                @L["Status.CheckedAt", report.CheckedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]
            </MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="CheckAsync">@L["Status.Retry"]</MudButton>
        </MudCardActions>
    </MudCard>
}
else
{
    @* Errors stay visible until the user checks again (DESIGN 9). *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" role="alert">
        <MudText Typo="Typo.subtitle1" HtmlTag="p">@L["Status.Problem"]</MudText>
        <MudText Typo="Typo.body2" HtmlTag="p">@errorText</MudText>
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="CheckAsync">@L["Status.Retry"]</MudButton>
}

@code {
    private readonly CancellationTokenSource disposed = new();
    private bool checking = true;
    private HealthStatus? health;
    private string? errorText;

    protected override Task OnInitializedAsync() => CheckAsync();

    private async Task CheckAsync()
    {
        checking = true;
        health = null;
        errorText = null;

        var result = await Api.GetAsync<HealthStatus>("v1/health", disposed.Token);

        if (result.IsSuccess)
        {
            health = result.Value;
        }
        else
        {
            errorText = SharedResource.ErrorText(L, result.ErrorCode!);
        }

        checking = false;
    }

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }
}
