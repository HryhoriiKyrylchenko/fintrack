@page "/buckets"
@using FinTrack.Budget.Contracts.V1.Buckets
@inject BucketsClient Buckets
@inject OwnerSettingsState Settings
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

@* The owner's buckets (plan 1a step 14): definitions only; balances are on the Overview. A table on wide
   screens, cards below the md breakpoint (DESIGN 8). *@

<PageTitle>@L["Buckets.PageTitle"]</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    <MudText Typo="Typo.h5" HtmlTag="h1">@L["Buckets.Title"]</MudText>
    @if (rows is { Count: > 0 })
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">
            @L["Buckets.New"]
        </MudButton>
    }
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["Buckets.Description"]</MudText>

<MudSwitch T="bool" Value="showArchived" ValueChanged="ShowArchivedChangedAsync" Color="Color.Primary" Label="@L["Buckets.ShowArchived"]" Class="mb-4" />

@if (loadError is not null)
{
    <ErrorAlert Error="loadError" Class="mb-4" />
    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync">@L["Common.Retry"]</MudButton>
}
else if (rows is null)
{
    <TableSkeleton Rows="4" />
}
else if (rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.Savings" Title="@L["Buckets.Empty.Title"]" Text="@L["Buckets.Empty.Text"]">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">
            @L["Buckets.Empty.Action"]
        </MudButton>
    </EmptyState>
}
else
{
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudSimpleTable Elevation="0" Outlined="true" Hover="true">
            <thead>
                <tr>
                    <th scope="col">@L["Buckets.Column.Name"]</th>
                    <th scope="col">@L["Buckets.Column.Currency"]</th>
                    <th scope="col">@L["Buckets.Column.Kind"]</th>
                    <th scope="col" class="fintrack-actions-column">@L["Buckets.Column.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var name = row.DisplayName(L);
                    <tr>
                        <td>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <span>@name</span>
                                <BucketLabels Row="row" />
                            </MudStack>
                        </td>
                        <td>@row.Bucket.Currency.Code</td>
                        <td>@L[row.KindKey]</td>
                        <td class="fintrack-actions-column">
                            @if (row.IsSystem)
                            {
                                <MudTooltip Text="@L["Buckets.SystemHint"]">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Secondary" Size="Size.Small" aria-label="@L["Buckets.SystemHint"]" role="img" />
                                </MudTooltip>
                            }
                            else if (!row.IsArchived)
                            {
                                <MudTooltip Text="@L["Buckets.Rename"]">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="@L["Buckets.RenameNamed", name]" OnClick="() => RenameAsync(row)" />
                                </MudTooltip>
                                <MudTooltip Text="@L["Buckets.Archive"]">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Archive" aria-label="@L["Buckets.ArchiveNamed", name]" OnClick="() => ArchiveAsync(row)" />
                                </MudTooltip>
                            }
                            else if (row.CanUnarchive)
                            {
                                <MudTooltip Text="@L["Buckets.Unarchive"]">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Unarchive" aria-label="@L["Buckets.UnarchiveNamed", name]" OnClick="() => UnarchiveAsync(row)" />
                                </MudTooltip>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudStack Spacing="2">
            @foreach (var row in rows)
            {
                var name = row.DisplayName(L);
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@name</MudText>
                            <BucketLabels Row="row" />
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Buckets.CardLine", row.Bucket.Currency.Code, L[row.KindKey]]</MudText>
                        @if (row.IsSystem)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" HtmlTag="p" Class="mt-1">@L["Buckets.SystemHint"]</MudText>
                        }
                    </MudCardContent>
                    @if (row.CanRename || row.CanArchive)
                    {
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Edit" aria-label="@L["Buckets.RenameNamed", name]" OnClick="() => RenameAsync(row)">
                                @L["Buckets.Rename"]
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Archive" aria-label="@L["Buckets.ArchiveNamed", name]" OnClick="() => ArchiveAsync(row)">
                                @L["Buckets.Archive"]
                            </MudButton>
                        </MudCardActions>
                    }
                    else if (row.CanUnarchive)
                    {
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Unarchive" aria-label="@L["Buckets.UnarchiveNamed", name]" OnClick="() => UnarchiveAsync(row)">
                                @L["Buckets.Unarchive"]
                            </MudButton>
                        </MudCardActions>
                    }
                </MudCard>
            }
        </MudStack>
    </MudHidden>
}

@code {
    private static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private IReadOnlyList<BucketRow>? rows;
    private ErrorInfo? loadError;
    private bool showArchived;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        rows = null;
        loadError = null;
        var result = await Buckets.ListAsync(showArchived, CancellationToken.None);
        if (result.Value is { } buckets)
        {
            rows = [.. buckets.Select(bucket => new BucketRow(bucket))];
        }
        else
        {
            loadError = ErrorInfo.From(result);
        }
    }

    private Task ShowArchivedChangedAsync(bool value)
    {
        showArchived = value;
        return LoadAsync();
    }

    private async Task CreateAsync()
    {
        // The layout shows pages only with saved settings.
        var model = BucketFormModel.ForCreate(Settings.Settings!.ReportingCurrency);
        var parameters = new DialogParameters<BucketDialog> { { dialog => dialog.Model, model } };
        var reference = await Dialogs.ShowAsync<BucketDialog>(L["Buckets.CreateTitle"], parameters, Options);
        if (await reference.Result is { Canceled: false, Data: string name })
        {
            Snackbar.Add(L["Buckets.Created", name], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task RenameAsync(BucketRow row)
    {
        var parameters = new DialogParameters<BucketDialog> { { dialog => dialog.Model, BucketFormModel.ForRename(row.Bucket) } };
        var reference = await Dialogs.ShowAsync<BucketDialog>(L["Buckets.RenameTitle", row.DisplayName(L)], parameters, Options);
        if (await reference.Result is { Canceled: false, Data: string name })
        {
            Snackbar.Add(L["Buckets.Renamed", name], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ArchiveAsync(BucketRow row)
    {
        var name = row.DisplayName(L);
        var parameters = new DialogParameters<ArchiveBucketDialog> { { dialog => dialog.BucketId, row.Bucket.Id } };
        var reference = await Dialogs.ShowAsync<ArchiveBucketDialog>(L["Buckets.ArchiveTitle", name], parameters, Options);
        if (await reference.Result is { Canceled: false })
        {
            Snackbar.Add(L["Buckets.ArchivedDone", name], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task UnarchiveAsync(BucketRow row)
    {
        var name = row.DisplayName(L);
        var parameters = new DialogParameters<ArchiveBucketDialog>
        {
            { dialog => dialog.BucketId, row.Bucket.Id },
            { dialog => dialog.Unarchive, true },
        };
        var reference = await Dialogs.ShowAsync<ArchiveBucketDialog>(L["Buckets.UnarchiveTitle", name], parameters, Options);
        if (await reference.Result is { Canceled: false })
        {
            Snackbar.Add(L["Buckets.UnarchivedDone", name], Severity.Success);
            await LoadAsync();
        }
    }
}
