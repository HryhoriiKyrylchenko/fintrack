<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    The front end: Blazor WebAssembly, hosted as static files (ARCHITECTURE 2.1). It talks to the
    Api over HTTP only; UI rules are in docs/DESIGN.md.
  -->
  <PropertyGroup>
    <!-- Fills the fingerprinted asset names into wwwroot/index.html (the .NET 10 default). -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      All ICU culture data (icudt.dat, about 330 KB compressed) instead of the shard the browser's
      language selects (144 to 249 KB). The owner's locale is a setting, not the browser's language:
      with shards, pl-PL in an English browser has no culture data and would format as English
      (measured in plan 1a step 4).
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <!-- The JSON contract (FinTrackJson), kernel types and Budget's read contracts (DTOs, request bodies). -->
    <ProjectReference Include="../../Budget/FinTrack.Budget.Contracts/FinTrack.Budget.Contracts.csproj" />
    <ProjectReference Include="../../Shared/FinTrack.Shared.Kernel/FinTrack.Shared.Kernel.csproj" />
  </ItemGroup>
</Project>
