@* Confirms archiving or unarchiving and names the bucket in its title (DESIGN 9). A refusal, such as a bucket that
   still holds money (bucket.not_empty) or a name in use again (bucket.name_taken), is explained here and stays
   until the dialog is closed. Closes with true when done. *@
@inject BucketsClient Buckets
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">@L[Unarchive ? "Buckets.UnarchiveText" : "Buckets.ArchiveText"]</MudText>
        @if (error is not null)
        {
            <ErrorAlert Error="error" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="busy">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="@(busy || error is not null)" OnClick="ConfirmAsync">
            @L[Unarchive ? "Buckets.UnarchiveConfirm" : "Buckets.ArchiveConfirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool busy;
    private ErrorInfo? error;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The bucket to archive or unarchive.</summary>
    [Parameter, EditorRequired]
    public Guid BucketId { get; set; }

    /// <summary>Whether the dialog makes an archived bucket active again instead of archiving it.</summary>
    [Parameter]
    public bool Unarchive { get; set; }

    private void Cancel() => Dialog.Cancel();

    private async Task ConfirmAsync()
    {
        busy = true;
        var result = Unarchive
            ? await Buckets.UnarchiveAsync(BucketId, CancellationToken.None)
            : await Buckets.ArchiveAsync(BucketId, CancellationToken.None);
        if (result.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(true));
            return;
        }

        error = ErrorInfo.From(result);
        busy = false;
    }
}
